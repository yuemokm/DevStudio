{
  "name": "lumen",
  "version": "0.1.0",
  "description": "Lumen — A visual editor for HTML, Vue, React, and Astro projects",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "npm run build:electron && concurrently \"npm run dev:renderer\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "dev:renderer": "vite",
    "build": "npm run build:renderer && npm run build:electron",
    "build:renderer": "vite build",
    "build:electron": "vite build --config electron.vite.config.ts",
    "preview": "vite preview",
    "lint": "eslint . --ext ts,tsx",
    "electron": "electron .",
    "start": "electron ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@vue/compiler-sfc": "^3.5.32",
    "lucide-react": "^0.503.0",
    "parse5": "^8.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.3",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "concurrently": "^9.1.2",
    "electron": "^35.2.1",
    "electron-devtools-installer": "^4.0.0",
    "playwright": "^1.59.1",
    "postcss": "^8.5.3",
    "tailwindcss": "^4.1.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.3",
    "wait-on": "^8.0.3"
  },
  "keywords": [
    "electron",
    "visual-editor",
    "html",
    "vue",
    "react",
    "astro"
  ],
  "author": "",
  "license": "MIT"
}
